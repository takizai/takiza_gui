{
  "name": "tauri-app",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.mjs",
    "predev": "npm run version:sync",
    "prebuild": "npm run version:sync && npm run check:tauri",
    "pretauri": "npm run version:sync && npm run check:tauri",
    "test:prompt": "node tests/prompt-input.cjs",
    "test:theme": "node tests/theme.cjs",
    "test:agent": "node tests/agent-queue.cjs",
    "test:core": "python3 tests/core-check.py",
    "test:providers": "node tests/provider-models.cjs",
    "test:i18n": "node tests/i18n.cjs",
    "test:messages": "node tests/message-actions.cjs && node tests/smooth-stream.cjs",
    "test": "npm run test:prompt && npm run test:theme && npm run test:agent && npm run test:providers && npm run test:messages && npm run test:i18n && npm run test:workspace && npm run test:provider-settings && npm run test:effort && npm run test:questions && npm run test:titles && npm run test:release",
    "test:workspace": "node tests/workspace-picker.cjs",
    "test:provider-settings": "node tests/provider-settings.cjs",
    "test:effort": "node tests/effort.cjs",
    "test:questions": "node tests/questionnaire.cjs",
    "test:titles": "node tests/session-titles.cjs",
    "test:release": "node --test tests/release-version.mjs tests/tauri-versions.mjs",
    "check:tauri": "node scripts/check-tauri-versions.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "highlight.js": "^11.12.0",
    "ldrs": "^1.1.9",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
